NODE_ENV=production
PORT=8787
SMETA_AUTH_MODE=server
SMETA_SESSION_TTL_HOURS=24
SMETA_DATA_DIR=./data

# Set these only on the real server/hosting control panel.
# Do not commit real credentials.
SMETA_BOOTSTRAP_OWNER_LOGIN=
SMETA_BOOTSTRAP_OWNER_PASSWORD=
SMETA_BOOTSTRAP_OWNER_NAME=

# Optional service token for scheduled internal AI project sweeps.
# Keep it secret; rotate it if it was ever sent in a chat.
SMETA_AGENT_SWEEP_TOKEN=
SMETA_OFFICE_API_URL=http://127.0.0.1:8787/api
